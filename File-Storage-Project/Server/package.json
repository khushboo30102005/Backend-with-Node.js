{
  "name": "file-storage-project",
  "version": "1.0.0",
  "description": "SFECAPP (Smart File & Ephemeral Collaboration System) API server",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-test-module-mocks tests/*.test.js",
    "start": "node app.js",
    "dev": "node --watch --env-file=.env app.js",
    "debug": "node --inspect --env-file=.env app.js",
    "setup": "node --env-file=.env config/setup.js",
    "setup:ai": "node --env-file=.env config/setupAi.js",
    "owner:token": "node scripts/initOwner.js --generate-token",
    "owner:init": "node --env-file=.env scripts/initOwner.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/lib-storage": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dompurify": "^3.4.14",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "jsdom": "^30.0.1",
    "mammoth": "^1.13.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.6.3",
    "nodemailer": "^10.5.0",
    "pdf-parse": "^1.1.1",
    "razorpay": "^2.9.8",
    "redis": "^6.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
